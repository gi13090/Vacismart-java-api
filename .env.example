# Somente exemplos locais, sem segredos reais. Nunca usar em produção.
DB_URL=jdbc:postgresql://localhost:5432/vacismart
DB_NAME=vacismart
DB_USER=vacismart
DB_PASSWORD=exemplo-local-nao-producao

# J4: caminhos de chaves locais externas, obrigatórios para iniciar a API.
# JWT_CHAVE_PUBLICA=file:/caminho/externo/publica.pem
# JWT_CHAVE_PRIVADA=file:/caminho/externo/privada.pem
# JWT_EMISSOR=vacismart
# JWT_VALIDADE=PT15M
# CORS_ORIGENS=http://localhost:5173
# Provisionamento demo fica DESABILITADO; veja README para ativação local explícita.

# D1: variáveis adicionais para docker-compose.yml (copie para .env.docker).
# Caminhos ABSOLUTOS externos no host, sem prefixo file:; arquivos obrigatórios.
# DOCKER_JWT_PUBLIC_KEY=/caminho/externo/publica.pem
# DOCKER_JWT_PRIVATE_KEY=/caminho/externo/privada.pem
# API_PORT=8080
# No Compose D1, DB_URL é calculado com o serviço postgres, não localhost.
